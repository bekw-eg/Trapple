* text=auto eol=lf
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
# Unity writes a trailing space after empty YAML values.
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.physicsMaterial2D text eol=lf whitespace=-blank-at-eol
*.png binary
